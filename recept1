
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>MediCare - Appointment Receipt</title>

<style>
* {
    box-sizing: border-box;
}

body {
    margin: 0;
    font-family: Arial, sans-serif;
    background: #f1fbfa;
    color: #17354a;
}

/* Navigation */
header {
    background: white;
    padding: 18px 5%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    box-shadow: 0 2px 8px #dcebea;
}

.logo {
    font-size: 27px;
    font-weight: bold;
    color: #18a58e;
}

nav a {
    text-decoration: none;
    color: #17354a;
    margin-left: 20px;
}

/* Success message */
.container {
    max-width: 750px;
    margin: 35px auto;
    padding: 20px;
}

.success {
    text-align: center;
    margin-bottom: 28px;
}

.check {
    width: 70px;
    height: 70px;
    background: #18a58e;
    color: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 42px;
    margin: auto;
}

.success h1 {
    font-size: 28px;
    margin-bottom: 12px;
}

.success p {
    color: #648093;
}

/* Receipt */
.receipt {
    background: white;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 5px 20px #dcebea;
    border: 1px solid #dcebea;
}

.receipt-header {
    background: #079e91;
    color: white;
    padding: 22px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
}

.receipt-header h2 {
    margin: 0;
    font-size: 26px;
}

.receipt-header p {
    margin: 4px 0 0;
    font-size: 13px;
}

.receipt-header strong {
    font-size: 16px;
}

.receipt-body {
    padding: 25px;
}

.booking-info {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    padding-bottom: 20px;
    border-bottom: 1px solid #dcebea;
}

.section {
    padding: 20px 0;
    border-bottom: 1px solid #dcebea;
}

.section h3 {
    color: #17354a;
    margin: 0 0 20px;
    font-size: 18px;
}

.details {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
}

.detail {
    margin-bottom: 16px;
    overflow-wrap: anywhere;
}

.detail span {
    display: block;
    color: #648093;
    font-size: 13px;
    margin-bottom: 6px;
}

.detail strong {
    font-size: 14px;
}

.booking-id {
    color: #079e91;
    background: #e6f8f6;
    padding: 10px;
    display: inline-block;
    border-radius: 5px;
}

.note {
    background: #effaf9;
    padding: 15px;
    border-radius: 8px;
    margin-top: 20px;
    color: #648093;
    font-size: 13px;
    line-height: 1.7;
}

.note strong {
    color: #17354a;
}

.buttons {
    text-align: center;
    margin-top: 22px;
}

button {
    padding: 12px 35px;
    border: 1px solid #079e91;
    border-radius: 25px;
    background: white;
    color: #17354a;
    font-weight: bold;
    cursor: pointer;
}

button:hover {
    background: #e6f8f6;
}

.home {
    display: block;
    margin-top: 18px;
    color: #079e91;
    text-decoration: none;
    font-weight: bold;
    font-size: 14px;
}

footer {
    text-align: center;
    color: #648093;
    font-size: 13px;
    padding: 20px;
}

/* Mobile */
@media (max-width: 600px) {
    header {
        flex-direction: column;
        gap: 15px;
    }

    nav a {
        margin: 5px;
        font-size: 13px;
    }

    .receipt-header {
        flex-direction: column;
        align-items: flex-start;
    }

    .booking-info,
    .details {
        grid-template-columns: 1fr;
        gap: 5px;
    }

    .success h1 {
        font-size: 23px;
    }

    .receipt-body {
        padding: 18px;
    }
}

/* Print receipt only */
@media print {
    body {
        background: white;
    }

    header, footer, .success, .buttons {
        display: none;
    }

    .container {
        margin: 0;
        padding: 0;
        max-width: 100%;
    }

    .receipt {
        box-shadow: none;
        border: 1px solid #ddd;
    }

    .receipt-header, .note {
        print-color-adjust: exact;
        -webkit-print-color-adjust: exact;
    }
}
</style>
</head>

<body>

<header>
    <div class="logo">✚ MediCare</div>


</header>

<div class="container">

    <div class="success">
        <div class="check">✓</div>
        <h1>Appointment Booked Successfully!</h1>
        <p>Your appointment has been confirmed</p>
    </div>

    <div class="receipt">

        <div class="receipt-header">
            <div>
                <h2>✚ MediCare</h2>
                <p>Doctor Appointment</p>
            </div>

            <strong>Appointment Receipt</strong>
        </div>

        <div class="receipt-body">

            <div class="booking-info">
                <div class="detail">
                    <span>Booking ID</span>
                    <strong class="booking-id" id="bookingId">
                        MC-20261001
                    </strong>
                </div>

                <div class="detail">
                    <span>Booking Date</span>
                    <strong id="bookingDate">01 Oct 2026</strong>
                </div>
            </div>

            <div class="section">
                <h3>♟ Patient Details</h3>

                <div class="details">
                    <div class="detail">
                        <span>Full Name</span>
                        <strong id="patientName">Your Name</strong>
                    </div>

                    <div class="detail">
                        <span>Phone Number</span>
                        <strong id="patientPhone">Your Phone Number</strong>
                    </div>

                    <div class="detail">
                        <span>Email Address</span>
                        <strong id="patientEmail">your@email.com</strong>
                    </div>

                    <div class="detail">
                        <span>Gender</span>
                        <strong id="patientGender">Not provided</strong>
                    </div>
                </div>
            </div>

            <div class="section">
                <h3>♧ Appointment Details</h3>

                <div class="details">
                    <div class="detail">
                        <span>Department</span>
                        <strong id="department">General Medicine</strong>
                    </div>

                    <div class="detail">
                        <span>Doctor</span>
                        <strong id="doctor">Dr. Priya</strong>
                    </div>

                    <div class="detail">
                        <span>Appointment Date</span>
                        <strong id="appointmentDate">12 Oct 2026</strong>
                    </div>

                    <div class="detail">
                        <span>Appointment Time</span>
                        <strong id="appointmentTime">10:00 AM</strong>
                    </div>
                </div>

              
            </div>

            <div class="note">
                <p>Please arrive 10 minutes early for your appointment.</p>
                
            </div>

            <div class="buttons">
                <button onclick="window.print()">
                    ▣ &nbsp; Print Receipt
                </button>

                <a href="index.html" class="home">Back to Home</a>
            </div>

        </div>
    </div>
</div>

<footer>
    © 2026 MediCare | Your Health, Our Priority
</footer>

</body>
</html>
```
